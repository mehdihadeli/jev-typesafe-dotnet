<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Jev.Typesafe.Sdk</PackageId>
    <RootNamespace>Jev.Typesafe.Sdk</RootNamespace>
    <Title>Jev TypeSafe SDK</Title>
    <Authors>Mehdi Hadeli</Authors>
    <Description>Community .NET port of the official TypeSafe Python SDK for the TypeSafe AI System One API. Ask typed Noul, Choice, and Score questions and discover available models.</Description>
    <PackageTags>typesafe;ai;system-one;jev;sdk;classification</PackageTags>
    <PackageProjectUrl>https://github.com/mehdihadeli/typesafe-jev-dotnet-sdk</PackageProjectUrl>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryUrl>https://github.com/mehdihadeli/typesafe-jev-dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <LangVersion>preview</LangVersion>
    <TargetFramework />
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Net.Http.Json" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Resilience" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <InternalsVisibleTo Include="Jev.Typesafe.Sdk.UnitTests" />
    <Using Include="Jev.Typesafe.Sdk.Models" />
    <Using Include="Jev.Typesafe.Sdk.Exceptions" />
    <Using Include="Jev.Typesafe.Sdk.Serialization" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <Target Name="ApplyReleasePackageVersion" AfterTargets="GetBuildVersion" Condition="'$(ReleasePackageVersion)' != ''">
    <PropertyGroup>
      <PackageVersion>$(ReleasePackageVersion)</PackageVersion>
    </PropertyGroup>
  </Target>
</Project>